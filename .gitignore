# =============================================================================
# Arecibo-SSE — .gitignore global del monorepositorio
# =============================================================================

# --- Binarios Go ---
*.exe
*.exe~
*.dll
*.so
*.dylib
/services/publisher/publisher
/services/gateway/gateway

# --- Artefactos de testing Go ---
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# --- Dependencias Go (vendor opcional) ---
# vendor/

# --- Workspace Go (usamos módulos independientes por servicio) ---
go.work
go.work.sum

# --- Frontend Node ---
node_modules/
/web/dist/
/web/.vite/
/web/coverage/

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# --- Docker ---
# No ignorar docker-compose, sí ignorar overrides locales
docker-compose.override.yml

# --- Editores e IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Datos temporales ---
tmp/
temp/
